{
  "manifest_version": 3,
  "name": "学术引用复制助手",
  "version": "1.0.0",
  "description": "复制网页文本时，自动在末尾追加网页标题、作者和链接，方便论文写作时标注来源。",
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
